# ~/kitchen-fetcher/config.env on the home server. Never overwritten by deploy.
# MODE: dry-run (fetch and log counts, send nothing) or push (send to the app).
MODE=dry-run
KITCHEN_ORIGIN=https://groceries.vexed.works
# FOLDER_SHOPS=dirk,lidl,jumbo
# AH_MODE: the same for Thomas's AH receipts (fetcher/ah_import.mjs).
AH_MODE=dry-run
# AH_TOKEN_FILE=ah-tokens.json
# AH_STATE_DIR=ah-state
# LIDL_MODE: the same for Thomas's Lidl Plus receipts and coupons (fetcher/lidl_import.mjs).
LIDL_MODE=dry-run
# LIDL_TOKEN_FILE=lidl-tokens.json
# LIDL_STATE_DIR=lidl-state
# PRICES_MODE: the same for the shelf prices from Checkjebon (fetcher/prices.mjs).
PRICES_MODE=dry-run
# REVIEW_MODE: on runs the nightly Claude check after the run (fetcher/review.sh); anything else skips it.
# Needs Claude Code logged in on this server and ./reviewer-token (node fetcher/review.mjs pair).
REVIEW_MODE=off
# REVIEW_MODEL=claude-sonnet-5-5
# REVIEW_MAX_TURNS=25
# REVIEW_TIMEOUT=900
# REVIEW_MAX_USD=1
# REVIEW_CLAUDE=/home/vexed/.local/bin/claude
