<?xml version="1.0" encoding="utf-8"?>
<!-- One "Al nodig?" row: the circle (1.5: straight into the basket, like a ticked line), the name,
     what is left ("nog 5 · ~6 dagen") and "Nog niet". Only the circle ticks. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingEnd="16dp">

    <!-- 48dp of touch area around the 22dp ring, as in widget_line.xml. -->
    <ImageView
        android:id="@+id/soon_tick"
        android:layout_width="52dp"
        android:layout_height="48dp"
        android:contentDescription="@string/widget_tick"
        android:paddingStart="16dp"
        android:paddingTop="13dp"
        android:paddingEnd="14dp"
        android:paddingBottom="13dp"
        android:src="@drawable/check_ring" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/soon_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/ink"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/soon_left"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:textColor="@color/mute"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- "Nog niet": more left than the app thinks (or not needed for a few days). -->
    <TextView
        android:id="@+id/soon_not_yet"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginStart="4dp"
        android:fontFamily="monospace"
        android:gravity="center_vertical"
        android:letterSpacing="0.08"
        android:paddingStart="8dp"
        android:text="@string/soon_not_yet"
        android:textColor="@color/signal"
        android:textSize="11sp" />
</LinearLayout>
