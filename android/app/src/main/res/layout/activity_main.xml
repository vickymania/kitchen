<?xml version="1.0" encoding="utf-8"?>
<!-- The parts of vexed.works: mono eyebrow, big title with the red dot, ruled sections. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="32dp"
        android:paddingEnd="16dp"
        android:paddingBottom="32dp">

        <TextView
            android:id="@+id/eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:letterSpacing="0.12"
            android:text="@string/pair_eyebrow"
            android:textColor="@color/mute"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-condensed"
            android:textAllCaps="true"
            android:textColor="@color/ink"
            android:textSize="44sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="@color/rule" />

        <!-- Not linked yet -->
        <LinearLayout
            android:id="@+id/pair_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/pair_explain"
                android:textColor="@color/ink"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/code"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:autofillHints=""
                android:background="@drawable/field"
                android:fontFamily="monospace"
                android:gravity="center"
                android:hint="@string/pair_code"
                android:imeOptions="actionDone"
                android:inputType="number"
                android:letterSpacing="0.3"
                android:maxLength="6"
                android:textColor="@color/ink"
                android:textColorHint="@color/mute"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/pair_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/signal"
                android:textSize="14sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/pair"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/button_signal"
                android:text="@string/pair_button"
                android:textColor="@color/white_fixed" />
        </LinearLayout>

        <!-- Linked -->
        <LinearLayout
            android:id="@+id/paired_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/paired_as"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="monospace"
                android:textColor="@color/ink"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/paired_explain"
                android:textColor="@color/ink"
                android:textSize="16sp" />

            <Button
                android:id="@+id/pin_widget"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/button_signal"
                android:text="@string/pin_widget"
                android:textColor="@color/white_fixed" />

            <Button
                android:id="@+id/unpair"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/button_outline"
                android:text="@string/unpair"
                android:textColor="@color/ink" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
