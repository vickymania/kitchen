<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteViews: only LinearLayout, FrameLayout, TextView, ImageView and ListView here. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="8dp">

        <LinearLayout
            android:id="@+id/add_area"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.12"
                android:maxLines="1"
                android:text="@string/widget_eyebrow"
                android:textColor="@color/mute"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:maxLines="1"
                android:text="—"
                android:textColor="@color/ink"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:id="@+id/refresh"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/widget_refresh"
            android:padding="10dp"
            android:src="@drawable/ic_refresh" />

        <ImageView
            android:id="@+id/open_list"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/widget_open_list"
            android:padding="10dp"
            android:src="@drawable/ic_open" />

        <TextView
            android:id="@+id/add_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/button_signal"
            android:contentDescription="@string/widget_add"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="+"
            android:textColor="@color/white_fixed"
            android:textSize="28sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/rule"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:src="@color/rule"
        android:scaleType="fitXY"
        android:importantForAccessibility="no" />

    <FrameLayout
        android:id="@+id/list_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/lines"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:paddingBottom="8dp"
            android:clipToPadding="false" />

        <TextView
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/widget_empty"
            android:textColor="@color/mute"
            android:textSize="14sp" />
    </FrameLayout>
</LinearLayout>
