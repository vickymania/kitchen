<?xml version="1.0" encoding="utf-8"?>
<!-- The device token is sealed with this phone's keystore; nothing here travels to another device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
